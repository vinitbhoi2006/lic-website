// Production PostgreSQL Prisma Schema
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  ADMIN
  ADVISOR
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CONSULTATION_SCHEDULED
  FOLLOW_UP_REQUIRED
  RESOLVED
  CLOSED
}

enum ProductCategory {
  TERM_INSURANCE
  WHOLE_LIFE
  ENDOWMENT
  MONEY_BACK
  CHILD_FOCUSED
  RETIREMENT_PENSION
  ULIP
  GROUP_INSURANCE
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SIMULATED_DEV
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  name            String
  phone           String?
  passwordHash    String
  role            Role           @default(CUSTOMER)
  isEmailVerified Boolean        @default(false)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  enquiries       Enquiry[]
  consultations   Consultation[]
  auditLogs       AuditLog[]     @relation("UserAuditLogs")

  @@index([email])
}

model Enquiry {
  id                String                 @id @default(uuid())
  referenceNumber   String                 @unique
  userId            String?
  user              User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName          String
  mobileNumber      String
  email             String
  city              String
  category          ProductCategory
  preferredTime     String?
  preferredLanguage String                 @default("English")
  message           String
  status            EnquiryStatus          @default(NEW)
  internalNotes     String?
  assignedTo        String?
  consentGiven      Boolean                @default(true)
  consentVersion    String                 @default("v1.0-2026")
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  consultations     Consultation[]
  statusHistory     EnquiryStatusHistory[]
  consentRecords    ConsentRecord[]

  @@index([referenceNumber])
  @@index([status])
  @@index([mobileNumber])
  @@index([email])
}

model EnquiryStatusHistory {
  id         String        @id @default(uuid())
  enquiryId  String
  enquiry    Enquiry       @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  fromStatus EnquiryStatus
  toStatus   EnquiryStatus
  changedBy  String
  note       String?
  createdAt  DateTime      @default(now())

  @@index([enquiryId])
}

model Consultation {
  id            String   @id @default(uuid())
  enquiryId     String?
  enquiry       Enquiry? @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  requestedTime DateTime
  mode          String   @default("Phone")
  status        String   @default("REQUESTED")
  staffNotes    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([requestedTime])
}

model InsuranceProduct {
  id                String          @id @default(uuid())
  slug              String          @unique
  category          ProductCategory
  title             String
  tagline           String
  description       String
  intendedAudience  String
  keyFeaturesJson   String
  officialSourceUrl String
  lastVerifiedDate  DateTime
  isPublished       Boolean         @default(true)
  isDiscontinued    Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([category])
  @@index([slug])
}

model ConsentRecord {
  id             String   @id @default(uuid())
  enquiryId      String?
  enquiry        Enquiry? @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  ipAddress      String?
  userAgent      String?
  consentText    String
  consentPurpose String
  createdAt      DateTime @default(now())
}

model Notification {
  id           String             @id @default(uuid())
  recipient    String
  channel      String
  templateName String
  subject      String?
  body         String
  status       NotificationStatus @default(PENDING)
  providerRef  String?
  errorMessage String?
  retryCount   Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([status])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)
  actorName  String
  action     String
  entityType String
  entityId   String
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
